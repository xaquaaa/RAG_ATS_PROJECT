# Copy this file to .env and fill in your own free-tier keys. Never commit .env.

# Groq — free tier LLM inference, used ONLY for the final gated-generation step.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Supabase — free tier Postgres + pgvector, for persistent storage.
# Only needed once you swap the in-memory stores for the Supabase-backed ones.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# Local models (no keys needed — these run on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Pipeline tuning
SHORTLIST_SIZE=25
EVIDENCE_THRESHOLD=0.45
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
