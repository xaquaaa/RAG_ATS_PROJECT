# Copy this file to .env and fill in your own free-tier keys. Never commit .env.

# Groq — free tier LLM inference, used ONLY for the final gated-generation step.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Supabase — free tier Postgres + pgvector, for persistent storage.
# Only needed once you swap the in-memory stores for the Supabase-backed ones.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# Local models (no keys needed — these run on CPU via fastembed/ONNX, not
# PyTorch, to keep memory low enough for Render's free 512MB tier)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Pipeline tuning
SHORTLIST_SIZE=25
# Set from real calibration data (scripts/analyze_confidence_scores.py) —
# above the observed no-evidence score ceiling, favoring safe UNKNOWNs over
# confident wrong answers. See "Known limitation" in README.md.
EVIDENCE_THRESHOLD=0.15
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
RRF_K=60
NEAR_MISS_MARGIN=0.05
NEAR_MISS_MAX=10

# Confidence label margins (above EVIDENCE_THRESHOLD) for the UI's
# High/Medium/Low display. These are GUESSES — run
# scripts/analyze_confidence_scores.py against your real data and set these
# from its suggested output.
CONFIDENCE_HIGH_MARGIN=0.20
CONFIDENCE_MEDIUM_MARGIN=0.05
